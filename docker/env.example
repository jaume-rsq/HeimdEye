# Configuració del Docker Compose de HeimdEye: copia'l a docker/.env (no es versiona) i omple'l.
# El Compose el fa servir per als contenidors i per a les variables de compose.yaml.
APP_NAME=HeimdEye
APP_KEY=
APP_URL=http://localhost:8080
APP_LOCALE=ca
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Europe/Madrid
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=heimdeye
DB_USERNAME=heimdeye
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3700
CACHE_STORE=database
MAIL_MAILER=log

# local (correu i contrasenya) o cloudflare (Cloudflare Access)
HEIMDEYE_AUTH=local
# CF_ACCESS_TEAM_DOMAIN=equip.cloudflareaccess.com
# CF_ACCESS_AUD=
# IP del cloudflared o del proxy que hi ha davant (separades per comes, admet CIDR)
# HEIMDEYE_TRUSTED_PROXIES=192.168.20.7
HEIMDEYE_ADMIN_NAME=
HEIMDEYE_ADMIN_EMAIL=

# Omple la BBDD amb els seeders la primera vegada (si no hi ha cap usuari)
HEIMDEYE_SEED=false

# Mode demo: entrada amb un botó com a professor visitant, amb límits (vegeu el README)
HEIMDEYE_DEMO=false
# HEIMDEYE_DEMO_MAX_TIMEOUT=30
# HEIMDEYE_DEMO_RUNS_PER_HOUR=60
# HEIMDEYE_DEMO_VISITOR_HOURS=2

# Port de l'amfitrió on s'exposa l'app
HEIMDEYE_PORT=8080
# Túnel de Cloudflare dins el Compose (perfil "tunnel"): docker compose --profile tunnel up -d
# TUNNEL_TOKEN=
