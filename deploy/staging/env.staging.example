# /var/www/heimdeye/shared/.env de STAGING. Parteix de deploy/env.production.example i canvia:
HEIMDEYE_ENVIRONMENT=staging
APP_NAME="HeimdEye (staging)"
APP_URL=https://heimdeye-staging.julioantonio.cat
# La MATEIXA APP_KEY que producció: sense ella els secrets copiats (claus, contrasenyes) no es poden llegir.
APP_KEY=
# Cua pròpia, BBDD local del contenidor.
DB_HOST=127.0.0.1
DB_DATABASE=heimdeye
# CF_ACCESS_AUD de l'aplicació d'Access de staging (és diferent de la de producció).
CF_ACCESS_AUD=
# Cap ronda nocturna: no s'activa heimdeye-schedule.timer. Els checks només corren si els llances.
