# /var/www/heimdeye/shared/.env (propietari heimdeye, mode 640). Mai al repositori.
APP_NAME=HeimdEye
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://heimdeye.julioantonio.cat
APP_LOCALE=ca
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Europe/Madrid

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=heimdeye
DB_USERNAME=heimdeye
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3700
CACHE_STORE=database
MAIL_MAILER=log

HEIMDEYE_AUTH=cloudflare
CF_ACCESS_TEAM_DOMAIN=EQUIP.cloudflareaccess.com
CF_ACCESS_AUD=
HEIMDEYE_TRUSTED_PROXIES=192.168.20.7
HEIMDEYE_ADMIN_NAME=
HEIMDEYE_ADMIN_EMAIL=

HEIMDEYE_STUDENTS_CSV=/var/lib/heimdeye/students.csv
HEIMDEYE_NIGHTLY_AT=02:00
